{
    "info": {
      "name": "SDMS Backend",
      "_postman_id": "sdms-collection-001",
      "description": "Student Database Management System API (Sequelize)",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      { "key": "baseUrl", "value": "http://localhost:4000" },
      { "key": "jwt", "value": "" }
    ],
    "item": [
      {
        "name": "User Signup",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "url": { "raw": "{{baseUrl}}/api/user/signup", "host": ["{{baseUrl}}"], "path": ["api", "user", "signup"] },
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"student1@example.com\",\n  \"password\": \"TestPass123\",\n  \"role\": \"STUDENT\"\n}"
          }
        }
      },
      {
        "name": "User Login",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "url": { "raw": "{{baseUrl}}/api/user/login", "host": ["{{baseUrl}}"], "path": ["api", "user", "login"] },
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"student1@example.com\",\n  \"password\": \"TestPass123\"\n}"
          }
        }
      },
      {
        "name": "Get My User",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/user/me", "host": ["{{baseUrl}}"], "path": ["api", "user", "me"] }
        }
      },
      {
        "name": "Profile - Get",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/profile/", "host": ["{{baseUrl}}"], "path": ["api", "profile", ""] }
        }
      },
      {
        "name": "Profile - Edit Request",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{jwt}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "url": { "raw": "{{baseUrl}}/api/profile/edit-request", "host": ["{{baseUrl}}"], "path": ["api", "profile", "edit-request"] },
          "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Name\"\n}" }
        }
      },
      {
        "name": "Resume - Get",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/resume/", "host": ["{{baseUrl}}"], "path": ["api", "resume", ""] }
        }
      },
      {
        "name": "Certification - Upload",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{jwt}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "url": { "raw": "{{baseUrl}}/api/certification/upload", "host": ["{{baseUrl}}"], "path": ["api", "certification", "upload"] },
          "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"<event-uuid>\",\n  \"fileUrl\": \"https://example.com/cert.pdf\"\n}" }
        }
      },
      {
        "name": "Certification - Pending (Admin)",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/certification/pending", "host": ["{{baseUrl}}"], "path": ["api", "certification", "pending"] }
        }
      },
      {
        "name": "Certification - Verify (Admin)",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{jwt}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "url": { "raw": "{{baseUrl}}/api/certification/verify/:submissionId", "host": ["{{baseUrl}}"], "path": ["api", "certification", "verify", ":submissionId"] },
          "body": { "mode": "raw", "raw": "{\n  \"status\": \"VERIFIED\"\n}" }
        }
      },
      {
        "name": "Event - Create (Admin)",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{jwt}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "url": { "raw": "{{baseUrl}}/api/event/", "host": ["{{baseUrl}}"], "path": ["api", "event", ""] },
          "body": { "mode": "raw", "raw": "{\n  \"name\": \"Workshop 1\",\n  \"date\": \"2024-08-01\",\n  \"type\": \"WORKSHOP\"\n}" }
        }
      },
      {
        "name": "Event - List",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/event/", "host": ["{{baseUrl}}"], "path": ["api", "event", ""] }
        }
      },
      {
        "name": "Event - Participate",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{jwt}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "url": { "raw": "{{baseUrl}}/api/event/participate", "host": ["{{baseUrl}}"], "path": ["api", "event", "participate"] },
          "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"<event-uuid>\"\n}" }
        }
      },
      {
        "name": "CodingStats - LeetCode",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{jwt}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "url": { "raw": "{{baseUrl}}/api/coding-stats/leetcode", "host": ["{{baseUrl}}"], "path": ["api", "coding-stats", "leetcode"] },
          "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://leetcode.com/yourprofile\",\n  \"problemsSolved\": 250\n}" }
        }
      },
      {
        "name": "CodingStats - HackerRank",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{jwt}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "url": { "raw": "{{baseUrl}}/api/coding-stats/hackerrank", "host": ["{{baseUrl}}"], "path": ["api", "coding-stats", "hackerrank"] },
          "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://hackerrank.com/yourprofile\",\n  \"problemsSolved\": 100\n}" }
        }
      },
      {
        "name": "CodingStats - Get",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/coding-stats/", "host": ["{{baseUrl}}"], "path": ["api", "coding-stats", ""] }
        }
      },
      {
        "name": "Notification - List",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/notifications/", "host": ["{{baseUrl}}"], "path": ["api", "notifications", ""] }
        }
      },
      {
        "name": "Notification - Mark as Read",
        "request": {
          "method": "POST",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/notifications/read/:notificationId", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "read", ":notificationId"] }
        }
      },
      {
        "name": "Leaderboard - All",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/leaderboard/", "host": ["{{baseUrl}}"], "path": ["api", "leaderboard", ""] }
        }
      },
      {
        "name": "Leaderboard - My Rank",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/leaderboard/me", "host": ["{{baseUrl}}"], "path": ["api", "leaderboard", "me"] }
        }
      },
      {
        "name": "Admin - Logs (Admin)",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/admin/logs", "host": ["{{baseUrl}}"], "path": ["api", "admin", "logs"] }
        }
      },
      {
        "name": "Admin - Export Students (Admin)",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
          "url": { "raw": "{{baseUrl}}/api/admin/export-students", "host": ["{{baseUrl}}"], "path": ["api", "admin", "export-students"] }
        }
      }
    ]
  }